{
  "manifest_version": 3,
  "name": "Internship Application Copilot",
  "version": "1.0.0",
  "description": "Smart, privacy-first internship application assistant and autofill copilot.",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "scripting",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_title": "Open Internship Copilot"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
