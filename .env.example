# PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/internship_copilot?schema=public"

# OpenAI API Configuration
OPENAI_API_KEY="sk-..."
OPENAI_FAST_MODEL="gpt-4o-mini"
OPENAI_WORKHORSE_MODEL="gpt-4o"
OPENAI_REASONING_MODEL="o3-mini"

# Authentication & Extension Token Secrets
AUTH_SECRET="your-32-byte-secret-here"
EXTENSION_JWT_SECRET="your-extension-jwt-secret-here"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Object Storage (S3 / Cloudflare R2)
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="internship-copilot-resumes"
S3_REGION="auto"
